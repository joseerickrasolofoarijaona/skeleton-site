# Copiez ce fichier en ".env" puis remplissez les valeurs.
# Ne publiez JAMAIS le fichier ".env" (mots de passe).

# Compte MariaDB créé avec database/utilisateur.sql
DB_USER=honey_app
DB_PASSWORD=mot-de-passe-du-compte-honey_app

# Clé secrète Django : générez-en une avec
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 1 = développement, 0 = site en ligne (clé secrète obligatoire)
DJANGO_DEBUG=1

# Nombre maximal de demandes de réservation par heure et par adresse IP
RESERVATIONS_MAX_PAR_HEURE=5

# E-mails. Si SMTP_HOST est vide, les e-mails s'affichent dans le terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
